{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wildfloral.online"
        }
      ],
      "destination": "https://www.wildfloral.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
  {
    "source": "/((?!sitemap\\.xml|robots\\.txt|llms\\.txt|logo\\.png|favicon\\.svg|.*\\..*).*)",
    "destination": "/$1/index.html"
  }
]
}